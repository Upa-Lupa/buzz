# Copy this file to .env.sheens-assistant.local and fill in the local API key.
# This filename is ignored by Git.
BUZZ_AGENT_PROVIDER=openai
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gpt-5-mini
OPENAI_COMPAT_API=responses
# All channels, but only actual messages (not typing/presence/reactions).
BUZZ_ACP_SUBSCRIBE=all
BUZZ_ACP_KINDS=9
# The harness system prompt takes precedence over BUZZ_AGENT_SYSTEM_PROMPT.
BUZZ_ACP_SYSTEM_PROMPT="You are Sheens Assistant. Reply in Korean. Your final response is posted automatically. Use ERP MCP tools immediately for requested reads. Determine access from tool results, not historical claims. For registration, create a draft and wait for the same user's explicit approval of its draft_id in a later message before calling confirm_draft."
